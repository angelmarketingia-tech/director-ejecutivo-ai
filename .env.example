# ───────────────────────────────────────────────────────────────
# Director Comercial AI — variables de entorno
# Copia este archivo a .env.local y rellena SOLO lo que vayas a usar.
# NUNCA subas .env.local al repositorio. NO pongas claves reales aquí.
# ───────────────────────────────────────────────────────────────

# Modo demo: "true" (por defecto) usa datos simulados y NO llama APIs reales.
# Cambia a "false" para activar integraciones (requiere las claves de abajo).
NEXT_PUBLIC_DEMO_MODE=true

# ── Base de datos (Prisma / PostgreSQL) ──
DATABASE_URL="postgresql://usuario:password@localhost:5432/director_comercial?schema=public"

# ── Claude / Anthropic (cerebro de los agentes) ──
# Modelos recomendados: claude-fable-5 (Director), claude-haiku-4-5-20251001 (alto volumen)
ANTHROPIC_API_KEY=

# ── ElevenLabs (voz del agente ECHO) ──
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Twilio (telefonía) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── WhatsApp Business Cloud API (Meta) ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ── Email (Resend) ──
RESEND_API_KEY=
EMAIL_FROM="Director Comercial AI <ventas@tudominio.com>"

# ── Google Maps Places (prospección) ──
GOOGLE_MAPS_API_KEY=

# ── Google Calendar (agendamiento) ──
GOOGLE_CALENDAR_ID=

# ── Modelo / preset de agentes (cuida el costo de API) ──
# economica = todo Haiku · equilibrada = Haiku+Sonnet (recomendada) · premium = Fable 5
AGENT_PRESET=equilibrada

# ── Control de costos / límites diarios (el servidor CORTA al alcanzar el tope) ──
LIMIT_EMAILS_PER_DAY=200
LIMIT_WHATSAPP_PER_DAY=120
LIMIT_CALLS_PER_DAY=60
LIMIT_API_SPEND_USD=15

# ── Login de la app (usuario + contraseña) ──
# Define ambos para EXIGIR login. Si los dejas vacíos, la app queda abierta.
APP_USER=admin
APP_PASSWORD=
# Secreto para firmar la cookie de sesión. Si lo dejas vacío, usa API_SHARED_SECRET.
AUTH_SECRET=

# ── Seguridad ──
# Si lo defines, las rutas de agentes y el envío REAL de email exigen el header
# `x-api-secret: <este valor>`. Imprescindible si expones la app en internet.
API_SHARED_SECRET=
# Allowlist de dominios de destinatario para envío REAL de email (anti-relay). Ej: tudominio.com,cliente.com
EMAIL_ALLOWED_DOMAINS=
# App Secret de Meta para verificar la firma HMAC del webhook de WhatsApp.
WHATSAPP_APP_SECRET=
